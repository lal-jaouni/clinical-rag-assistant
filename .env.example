# Copy to .env and fill in values. .env is gitignored.

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=clinical_rag
POSTGRES_PASSWORD=changeme_localdev
POSTGRES_DB=clinical_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── LLM Provider Selection ────────────────────────────────
# LiteLLM supports: ollama, anthropic, openai, groq, azure, gemini, etc.
# Set LLM_PROVIDER and the matching API key (if not ollama).
# Model strings follow LiteLLM conventions:
#   ollama/llama3.1:8b
#   anthropic/claude-3-5-sonnet-20241022
#   openai/gpt-4o-mini
#   groq/llama-3.1-70b-versatile
LLM_PROVIDER=ollama
LLM_MODEL=ollama/llama3.1:8b

# API keys (only set the ones you use; leave blank otherwise)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama connection (default points at the docker-compose service)
OLLAMA_API_BASE=http://localhost:11434

# ── Data Ingestion ────────────────────────────────────────
# Optional NCBI API key for higher PubMed rate limits (3 req/s -> 10 req/s)
# https://www.ncbi.nlm.nih.gov/account/settings/ -> API Key Management
ENTREZ_API_KEY=
ENTREZ_EMAIL=your@email.example

# ── Observability (optional) ──────────────────────────────
# If set, LiteLLM logs all requests/responses to Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
